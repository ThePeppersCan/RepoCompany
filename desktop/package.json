{
  "name": "repo-company-launcher",
  "version": "0.1.36",
  "private": true,
  "description": "Your Repo Company collection, installed and connected.",
  "author": "Repo Company",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "package:directory": "electron-builder --win --dir --publish never",
    "package": "electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.6.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "uk.repocompany.launcher",
    "productName": "Repo Company",
    "directories": {
      "output": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "portal-preload.cjs",
      "game-preload.cjs",
      "config.cjs",
      "lib/**/*",
      "renderer/**/*",
      "game/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "renderer/assets/app.ico",
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "renderer/assets/app.ico",
      "uninstallerIcon": "renderer/assets/app.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "Repo-Company-${version}-Windows-${arch}.${ext}",
    "compression": "normal",
    "publish": {
      "provider": "generic",
      "url": "https://repocompany.uk/releases/launcher/",
      "publisherName": [
        "Repo Company Update Key"
      ]
    }
  }
}
